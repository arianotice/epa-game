{
  "ep": "EP05",
  "title": "运动会的吹泡泡与吸果冻",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B05": 0.5, "B09": 0.5, "B12": 1.0, "B24": 0.5, "B33": 1.0, "B40": 0.5, "B48": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，今天我们来到运动会！元音城堡第四站，抓第四对精灵。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "运动会！好热闹！有人在跑步！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先别跑。你看那边，有人在吹泡泡，还有人在吃果冻。今天这两个精灵，嘴巴都要撮圆。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "撮圆？像小鱼嘴那样吗？"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，像小鱼嘴。泡泡精灵吹泡泡的时候，嘴巴圆起来，气一下冲出来，声音很短——"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "o"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哦！泡泡破了！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！又短又快，泡泡一下就破了。它就住在 hot 里。跟我读——"},
    {"id": "B05en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "hot."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "hot！热的！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：吹泡泡，哦，短又快。"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二位精灵也在撮嘴巴，但它不吹泡泡——它在吸果冻。"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "吸果冻？我最喜欢果冻了！"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "吸果冻的时候，嘴巴也是圆的，但是要吸很久，声音拖得长长的——"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "or"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哦——！果冻吸进来了！"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！又长又圆，慢慢吸。它就住在 ball 里。跟我读——"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ball."},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "ball！球！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：吸果冻，哦——长又圆。"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这对精灵特别容易混，因为它们的嘴巴一样圆。区别只有一个：一个快，一个慢。"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "来，对比读三遍——"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "hot. ball. hot. ball. hot. ball."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 0.95, "text": "hot. ball. hot. ball. hot. ball."},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！进入单词宝藏时间！先慢速，再常速。"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一组，吹泡泡精灵家的小朋友，都是短促的。"},
    {"id": "B15", "role": "bobo", "lang": "en", "speed": 0.6, "text": "hot. dog. box."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "hot！dog！box！"},
    {"id": "B16", "role": "bobo", "lang": "en", "speed": 0.85, "text": "hot. dog. box."},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "热的、狗、盒子。三个都一下就收住。"},
    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二组，吸果冻精灵家的小朋友，都拖得长长的。"},
    {"id": "B19", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ball. horse. door."},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 1.0, "text": "ball！horse！door！马和大门！"},
    {"id": "B20", "role": "bobo", "lang": "en", "speed": 0.85, "text": "ball. horse. door."},
    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "球、马、门。三个都吸得长长的。"},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个单词到手！进入口诀记忆屋，拍手跟我念——"},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "嘴巴撮圆像小鱼，吹泡泡，哦，短又快，小狗 dog 守着 box；吸果冻，哦——长又圆，小马 horse 顶着 ball。快的吹泡，慢的吸冻，一快一慢记心间！"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 0.9, "text": "嘴巴撮圆像小鱼，吹泡泡，哦，短又快，小狗 dog 守着 box；吸果冻，哦——长又圆，小马 horse 顶着 ball。快的吹泡，慢的吸冻，一快一慢记心间！"},
    {"id": "B24", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满血毕业！听辨大挑战来了。"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "来吧！我嘴巴已经圆好了！"},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题，听好——"},
    {"id": "B25en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "cot. caught."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个 cot 是短的，小床！第二个 caught 是长的，抓住了！"},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "全对！第一颗星。"},
    {"id": "B27", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二题——"},
    {"id": "B27en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "not. nought."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "not 是不，短的！nought 是零，长的！"},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "又对！耳朵越来越灵了。"},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三题，最后一题——"},
    {"id": "B29en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "spot. sport."},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "spot 是斑点，短的！sport 是运动，长的！我们就在运动会上！"},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "三题全对！满星！运动会这对精灵被你抓齐了。"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "泡泡和果冻！我都抓住了！"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "下一站，天要黑了——我们去睡前故事时间。"},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "在那里，又有两个撮圆嘴巴的精灵等着你：一个在轻轻推东西，一个在吹蜡烛。"},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "吹蜡烛！那我要睡觉了！"},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别急，先把蜡烛吹灭。声音探险队，下一站见！"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
