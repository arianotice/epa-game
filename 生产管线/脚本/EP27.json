{
  "ep": "EP27",
  "title": "重音的秘密",
  "default_gap": 0.12,
  "gaps": {"B01": 0.35, "B05en": 0.28, "B06en": 0.28, "B07": 0.28, "B09": 0.28, "B12en": 0.28, "B17": 0.28, "B19en": 0.28, "B20en": 0.28, "B22": 0.28, "B23en": 0.28, "B25en": 0.28, "B28en": 0.28, "B29en": 0.35, "B30en": 0.28, "B31en": 0.35, "B33en": 0.35, "B35": 0.28, "B37en": 0.45, "B38en": 0.45, "B39": 0.6, "B40en": 0.45, "X20": 0.28},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，看地图！音节那一格已经亮了。今天我们继续往上爬，来到进阶峰第二站——重音峰。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "重音峰？是不是要背着重的东西爬山呀？"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不用背东西，用的是声音里的力气。上一集我们把长单词切成蛋糕，banana 就是 ba、na、na。今天问你：这三块里哪一块最响？"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "三块都使劲不行吗？多用力总没坏处吧？"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不行。英语里每个词都有块特别亮的地砖，踩上去要重重一脚，其余的轻轻带过，那块就叫重音。注意它不是喊——喊是整句使劲，重音是只在一个点上使劲，别处反而要松。"},

    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先演个小剧场。小Q，今天是你的生日。我递给你一个系着丝带的盒子，跟你说——"},
    {"id": "B05en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "This is a present."},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "礼物！我要拆！我现在就要拆！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别急。盒子还是那个盒子，我只是换个说法：当着全班同学的面，把它送出去。"},
    {"id": "B06en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "I will present the gift."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "嗯？听起来……好像哪里怪怪的？"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "怪就怪在这儿：两句话里的 present，七个字母一模一样。可第一句重音砸在第一块，它是东西——礼物；第二句重音挪到第二块，立刻变成动作——赠送。"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "还有个副作用：重音一挪走，被冷落的音就变懒，元音缩成含含糊糊的一声「呃」，像在打瞌睡。记住这个画面——重音是聚光灯，照到哪儿哪儿亮，没照到的就暗下去。"},

    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "光听不够，身体要动起来。全体起立！规则是：念到重音那一块，你拍一下手喊「啪」；不是重音的块，你跺一下脚喊「咚」。"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先用 banana 热身。三块：ba、na、na，重音在中间那块。第一块，ba？"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "咚！"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "中间那块，na？"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啪！"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮，最后一块 na 也是咚。听我连起来念——"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ba-na-na."},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "热身完毕，上硬菜 present。第一块重，是礼物。前一块？"},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啪！"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "后一块？"},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "咚！"},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "换个位置，第二块重，是赠送。前一块？"},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "咚！"},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "后一块？"},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啪！"},

    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "同样两块砖，啪和咚换个位置，一个变成盒子，一个变成动作。送你一条偷懒神器：双音节词的站位规律。"},
    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "名词和形容词喜欢把重音放第一块，动词喜欢放第二块。所以碰到拼写一样、又能当东西又能当动作的词，听重音在前还是在后，就知道它在干什么活。看证据——唱片和录制。"},
    {"id": "B19en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "This is my record."},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "唱片！重音在前头，是个东西！"},
    {"id": "B20", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "换过来听——"},
    {"id": "B20en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "I will record a song."},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "重音跑到后面去了！变成录歌的动作了！"},
    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确。同一串字母，前重是唱片，后重是录制。这一条能帮你少背一半单词意思。"},

    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "进入对比示范。同一组词，先慢速，再常速，你一边听一边在心里拍手。"},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一组：东西和状态，重音站第一块。"},
    {"id": "B23en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ta-ble. win-dow. hap-py. stu-dent."},
    {"id": "B24en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "table. window. happy. student."},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "桌子、窗户、开心、学生，重音都在第一块。第二组，四个动作，重音站第二块。"},
    {"id": "B25en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "be-gin. for-get. de-cide. re-turn."},
    {"id": "B26en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "begin. forget. decide. return."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "开始、忘记、决定、回来！东西是啪咚，动作是咚啪！"},

    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "单词讲完，句子里也有分工：实词干活，虚词打杂。名词、动词、形容词、副词读得响、读得长；代词、冠词、介词和 be 动词是搭桥的，要轻读、快读、含糊地读。先听正常版——"},
    {"id": "B28en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "I want to go to the park."},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这句里干活的三个词：want 想去、go 去、park 公园，它们拍手；I、to、the 这些打杂的，轻轻跺脚带过。"},
    {"id": "B29en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "I. want. to. go. to. the. park."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哎？这一遍每个词都停了一下，像机器人念的！"},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，这是反面教材：每个词都重，等于每个词都不重。再听正常版——"},
    {"id": "B30en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "I want to go to the park."},

    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "例句宝藏！三句话，先听慢速，听清重音落在哪儿，再听常速跟着读。"},
    {"id": "B31en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "This is a present."},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这是我的一件礼物，present 重音在第一块，是个东西。准备跟读。"},
    {"id": "B32en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "This is a present."},
    {"id": "B33en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "I will present the gift."},
    {"id": "B34", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "我要把这份礼物赠送出去，重音挪到第二块，变成动作。准备跟读。"},
    {"id": "B34en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "I will present the gift."},

    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "宝藏收好，进入口诀记忆屋，一边拍手一边念——"},
    {"id": "B36", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "单词里有盏灯，照到哪块哪块明。名词形容词灯在前，动词常常灯在后。句子里实词重，虚词轻轻往前送！"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 0.9, "text": "单词里有盏灯，照到哪块哪块明。名词形容词灯在前，动词常常灯在后。句子里实词重，虚词轻轻往前送！"},

    {"id": "B37", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "口诀背熟，听辨大挑战！三道题，你要说出我念的词，重音是在前还是在后。"},
    {"id": "B37en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "table."},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啪咚！重音在前，是桌子！"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "正确，第一颗星。第二题，注意听——"},
    {"id": "B38en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "begin."},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "这个嘛……啪咚！重音也在前！"},
    {"id": "B39", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓：begin 是动词，开始，重音在第二块，是咚、啪。"},
    {"id": "X19", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啊——！我拍反了！我以为所有词都重前面呢！"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "错一题才记得牢。第三题，最后一题！"},
    {"id": "B40en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "window."},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "窗户是东西，重音在前！啪咚！"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确！今天两颗半星，收好。以后碰到长得一样的词，先问一句：重音在前，还是在后？"},

    {"id": "B42", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "今天的探险就到这里。下一站更神奇：它会让三个词挤成一坨，读起来只剩两个半。你会听到 not at all 变成一整串滑溜溜的声音，good boy 结尾那个音还要被偷偷吃掉一半——连读与失去爆破。"},
    {"id": "X23", "role": "xq", "lang": "zh", "speed": 1.0, "text": "吃掉？谁这么大胆！"},
    {"id": "B44", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "是英语自己吃的。声音探险队，下一站见！"},
    {"id": "X24", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
