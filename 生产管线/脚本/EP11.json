{
  "ep": "EP11",
  "title": "风吹头发与旅行行李箱",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B04": 0.5, "B08": 0.5, "B15": 1.0, "B35": 0.5, "B38": 1.0, "B43": 1.0, "B46": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，地图亮起来啦！上一站，我们在家里抓到了大房子惊叹音和耳边悄悄话音。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我记得！一个像看见大房子，另一个像贴着耳朵说悄悄话。"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！今天，元音城堡只剩最后两盏小灯。它们声音轻、动作小，是城堡里最文静的两个音。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "最文静？那我也轻一点说话……它们藏在哪儿？"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一盏灯藏在理发店。坐稳喽，围布一系，吹风机呼呼一吹，你的头发全站起来了！"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "等等！我的刘海怎么变成了一把小扫帚？"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先别压，听一听“头发”这个词。风一吹，嘴巴从短短的“诶”轻轻滑向放松的“呃”。"},
    {"id": "B05en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "hair."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "听起来像头发被风推着，轻轻滑了一小步。"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对。再看看你坐的椅子，这个词里也住着同一位文静精灵。"},
    {"id": "B06en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "chair."},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "原来它不只藏在头发里，还躲在理发椅里。"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "进入发音实验室。第一位文静精灵出场时，嘴巴先微微扁开，舌头在前面；接着下巴放松一点，舌头回到中间。气流一路畅通，声带自然唱歌。"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "hair."},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我的嘴巴只动了一点点，像怕吵醒正在午睡的猫。"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这就对了。记忆画面是：头发被风吹，“诶—呃”，轻轻滑，不要拖得太夸张。"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "理完发，我们去计划旅行。桌上有地图、帽子，还有一只张着大嘴的行李箱。"},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我把三包薯片、两只拖鞋和一只玩具熊全塞进去！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "行李箱都快打嗝了。听，“旅行”这个词里，第二位文静精灵来了。"},
    {"id": "B10en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "tour."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "它像我收拾行李时，小声念着“乌—呃”。"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二位出场时，嘴唇先轻轻收圆，舌头靠后；然后嘴唇松开，舌头回到中间。也是一路滑过去，气流不受阻挡。"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "tour."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一位先扁一点，第二位先圆一点，最后都回到放松的“呃”。"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "总结得真准！这两个音现在不算常见，单词也最少。今天认识它们、听见时能认出来，就已经很棒。"},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "来，做对比三连。先是风吹头发音，再是收拾行李音。"},
    {"id": "B13en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "hair. tour. hair. tour. hair. tour."},
    {"id": "X10", "role": "xq", "lang": "en", "speed": 0.85, "text": "hair. tour. hair. tour. hair. tour."},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "非常稳！现在进入单词宝藏时间。六个单词，每个先听慢速，再听中文意思，最后跟着常速读。"},
    {"id": "B15", "role": "bobo", "lang": "en", "speed": 0.6, "text": "hair."},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "头发。想象吹风机一开，刘海轻轻飘起来。准备，跟读。"},
    {"id": "B17", "role": "bobo", "lang": "en", "speed": 0.85, "text": "hair."},
    {"id": "B18", "role": "bobo", "lang": "en", "speed": 0.6, "text": "chair."},
    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "椅子。坐在理发椅上，背挺直，准备跟读。"},
    {"id": "B20", "role": "bobo", "lang": "en", "speed": 0.85, "text": "chair."},
    {"id": "B21", "role": "bobo", "lang": "en", "speed": 0.6, "text": "bear."},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "熊。要是玩具熊也想理发，可别把它剪成光头。准备跟读。"},
    {"id": "B23", "role": "bobo", "lang": "en", "speed": 0.85, "text": "bear."},
    {"id": "B24", "role": "bobo", "lang": "en", "speed": 0.6, "text": "pear."},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "梨。旅行路上带一个梨，清脆又解渴。准备跟读。"},
    {"id": "B26", "role": "bobo", "lang": "en", "speed": 0.85, "text": "pear."},
    {"id": "B27", "role": "bobo", "lang": "en", "speed": 0.6, "text": "tour."},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "旅行。把路线画在地图上，再检查一遍行李。准备跟读。"},
    {"id": "B29", "role": "bobo", "lang": "en", "speed": 0.85, "text": "tour."},
    {"id": "B30", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sure."},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "确定。出发前一定要确定车票和行李都带好了。准备跟读。"},
    {"id": "B32", "role": "bobo", "lang": "en", "speed": 0.85, "text": "sure."},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个宝藏全部装箱！前四个先微微扁嘴，后两个先轻轻圆唇。动作都小，声音都轻。"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "它们果然是最文静的两个音，连滑滑梯都不大喊大叫。"},
    {"id": "B34", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "进入口诀记忆屋。轻轻拍手，别把文静精灵吓跑。"},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "风吹头发诶到呃，扁嘴轻滑不拖拉；收拾行李乌到呃，圆唇放松去旅行。两个声音最文静，单词虽少认得清！"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 0.9, "text": "风吹头发诶到呃，扁嘴轻滑不拖拉；收拾行李乌到呃，圆唇放松去旅行。两个声音最文静，单词虽少认得清！"},
    {"id": "B36", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "口诀收好！接下来是听辨大挑战。每题有两个词，听清楚谁先扁嘴、谁先圆唇。"},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我的耳朵已经调到安静模式！"},
    {"id": "B37", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题！"},
    {"id": "B37en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "hair. tour."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个是头发，先扁嘴；第二个是旅行，先圆唇！"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确！第一颗安静小星星送给你。第二题来了！"},
    {"id": "B38en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "bear. sure."},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我确定，两个都是熊！一只大熊，一只……很确定的熊！"},
    {"id": "B39", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——第一个才是熊，第二个是“确定”。你把行李清单听成动物名单啦！"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "难怪我的行李箱里挤进来一只熊！快请它出去！"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "错一题，记得更牢。第三题，最后一组！"},
    {"id": "B40en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "chair. tour."},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "椅子先扁嘴，旅行先圆唇。这次我把耳朵竖得直直的！"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "回答正确！今天的两颗半安静小星星，全部装进口袋。"},
    {"id": "B42", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "元音城堡的二十盏灯，现在全部点亮！从长音、短音到双元音，我们完成了第一幕。"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哇，整座城堡亮晶晶的！下一站往哪儿走？"},
    {"id": "B43", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "下一站，我们离开元音城堡，跨过吊桥，进入辅音王国！第一场任务是纸飞机大赛。"},
    {"id": "X19", "role": "xq", "lang": "zh", "speed": 1.0, "text": "纸飞机？我的扫帚刘海正好可以测试风向！"},
    {"id": "B44", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "到时候，我们会遇见两个会“噗”地爆破的鼓点精灵，一个安静，一个会让喉咙振动。"},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "纸准备好，喉咙也准备好！"},
    {"id": "B46", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "声音探险队，下一站见！"},
    {"id": "X21", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
