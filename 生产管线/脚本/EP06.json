{
  "ep": "EP06",
  "title": "睡前故事的推与吹",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B05": 0.5, "B09": 0.5, "B12": 1.0, "B24": 0.5, "B33": 1.0, "B40": 0.5, "B48": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，天黑了。今天我们来到睡前故事时间，元音城堡第五站。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我要听故事！有月亮吗？"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "有月亮，还有一本厚厚的故事书。今天这两个精灵，嘴巴又都要撮圆。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "又是小鱼嘴！"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这次圆得更小，像一个小圆圈。第一位精灵，喜欢轻轻推东西——推门、推箱子，用的是巧劲。"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "oo"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "唔！轻轻地！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！又短又松，一下就停，肌肉一点都不紧张。它就住在 book 里。跟我读——"},
    {"id": "B05en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "book."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "book！故事书！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：轻轻推，唔，短又松。"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二位精灵不推东西，它在吹生日蜡烛。"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "吹蜡烛我知道！要吹很久！"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！嘴巴撮得又小又紧，气一直往外吹，声音拖得长长的——"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "oo"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "呜——！蜡烛灭了！"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！又长又紧。它就住在 food 里。跟我读——"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "food."},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "food！食物！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：吹蜡烛，呜——长又紧。"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这对精灵的嘴巴一样圆，区别在肌肉：一个是松的，一个是紧的。"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "来，对比读三遍——"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "book. food. book. food. book. food."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 0.95, "text": "book. food. book. food. book. food."},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！进入单词宝藏时间！先慢速，再常速。"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一组，轻轻推精灵家的小朋友，都又短又松。"},
    {"id": "B15", "role": "bobo", "lang": "en", "speed": 0.6, "text": "book. foot. good."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "book！foot！good！"},
    {"id": "B16", "role": "bobo", "lang": "en", "speed": 0.85, "text": "book. foot. good."},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "书、脚、好的。三个都轻轻一推就完事。"},
    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二组，吹蜡烛精灵家的小朋友，都又长又紧。"},
    {"id": "B19", "role": "bobo", "lang": "en", "speed": 0.6, "text": "food. moon. blue."},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 1.0, "text": "food！moon！blue！月亮是蓝色的！"},
    {"id": "B20", "role": "bobo", "lang": "en", "speed": 0.85, "text": "food. moon. blue."},
    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "食物、月亮、蓝色。三个都要吹得长长的。"},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个单词到手！进入口诀记忆屋，拍手跟我念——"},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "嘴巴圆成小圆圈，轻轻推，唔，短又松，故事 book 放在 foot 边；吹蜡烛，呜——长又紧，月亮 moon 照着 blue。松的是推，紧的是吹，一松一紧要分明！"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 0.9, "text": "嘴巴圆成小圆圈，轻轻推，唔，短又松，故事 book 放在 foot 边；吹蜡烛，呜——长又紧，月亮 moon 照着 blue。松的是推，紧的是吹，一松一紧要分明！"},
    {"id": "B24", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满血毕业！听辨大挑战来了。"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "来吧！"},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题，听好——"},
    {"id": "B25en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "full. fool."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个 full 是满的，短的！第二个 fool 是傻瓜，长的！"},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "全对！第一颗星。"},
    {"id": "B27", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二题——"},
    {"id": "B27en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "pull. pool."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "pull 是拉，短的！pool 是游泳池，长的！"},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "又对！"},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三题，最后一题——"},
    {"id": "B29en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "look. Luke."},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "look 是看，短的！Luke 是人名，长的！"},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "三题全对！满星毕业！"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "队长，我有点困了……"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "那就好好睡一觉。下一站，我们去动物园，还要在回家的路上抓两个特别懒的精灵。"},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "一个舌头会卷成小弹簧，一个只会懒洋洋地叹气。"},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "弹簧……呼……"},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "睡吧，我们下一站见。声音探险队，下一站见！"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "下一站……见……"}
  ]
}
