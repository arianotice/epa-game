{
  "ep": "EP04",
  "title": "上学路上的医生与鸭子",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B05": 0.5, "B09": 0.5, "B12": 1.0, "B24": 0.5, "B33": 1.0, "B40": 0.5, "B48": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，今天我们离开早餐桌，出门上学！元音城堡第三站，抓第三对精灵。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "上学路上！我看到小汽车了！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先别上车。昨天晚上你去医务室看过喉咙，还记得医生让你做什么吗？"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "记得！医生让我张嘴说「啊——」！"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！这个声音一出来，第一位精灵就现身了——医生精灵。"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "aaa"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啊——！我的嘴巴张到最大了！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "医生精灵的脾气是：嘴巴张到最大，舌头放平往后缩，声音又长又响，能拖很久。"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "它就住在 car 里。跟我读——"},
    {"id": "B06en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "car."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "car！小汽车！"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：医生查喉咙，啊——又长又开。"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "接下来第二位精灵，脾气完全相反。它会趁你不注意，轻轻戳你一下肚子。"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "戳肚子？"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，你被戳了一下，没防备，「啊」地叫出来——又短、又松、又随便。"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "u"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啊！短促的！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！嘴巴不用张大，肌肉全部放松，声音一下子就收住了。它就是戳肚子精灵。"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "它住在 bus 里。跟我读——"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "bus."},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "bus！公共汽车！"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住口诀：戳一下肚子，啊，短又松。"},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这对精灵特别好认：一个是医生让你慢慢张嘴，长长地「啊」；一个是别人突然戳你，短短地「啊」。"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "来，对比读三遍——"},
    {"id": "B14en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "car. bus. car. bus. car. bus."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 0.95, "text": "car. bus. car. bus. car. bus."},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！进入单词宝藏时间！先慢速，再常速。"},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一组，医生精灵家的小朋友，嘴巴都要张到最大。"},
    {"id": "B17", "role": "bobo", "lang": "en", "speed": 0.6, "text": "car. park. star."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "car！park！star！"},
    {"id": "B18", "role": "bobo", "lang": "en", "speed": 0.85, "text": "car. park. star."},
    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小汽车、公园、星星。三个都拖得长长的。"},
    {"id": "B20", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二组，戳肚子精灵家的小朋友，都是短促一下。"},
    {"id": "B21", "role": "bobo", "lang": "en", "speed": 0.6, "text": "bus. cup. duck."},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 1.0, "text": "bus！cup！duck！小鸭子！"},
    {"id": "B22", "role": "bobo", "lang": "en", "speed": 0.85, "text": "bus. cup. duck."},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "公共汽车、杯子、鸭子。三个都收得特别快。"},
    {"id": "B24", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个单词到手！进入口诀记忆屋，拍手跟我念——"},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "医生查喉咙，啊——又长又开，小汽车 car 开进 park；戳一下肚子，啊，短又松，鸭子 duck 跳上 bus。长的是医生，短的是戳肚，一长一短分清楚！"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 0.9, "text": "医生查喉咙，啊——又长又开，小汽车 car 开进 park；戳一下肚子，啊，短又松，鸭子 duck 跳上 bus。长的是医生，短的是戳肚，一长一短分清楚！"},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满血毕业！听辨大挑战来了。念两个词，说出你听到的是哪一个。"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "来吧！"},
    {"id": "B27", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题，听好——"},
    {"id": "B27en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "cart. cut."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个 cart 是长音！第二个 cut 是短的，切！"},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "全对！第一颗星到手。"},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二题，这两个词长得特别像——"},
    {"id": "B29en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "heart. hut."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "heart 是心脏，长长的！hut 是小屋，短短的！"},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "又对了！耳朵真灵。"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三题，也是最容易上当的一题——"},
    {"id": "B31en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "park. pup."},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "park 公园！pup 小狗！两个我都听出来了！"},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "三题全对！今天满星毕业！"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "太好了！医生精灵和戳肚子精灵都被我抓住了！"},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "抓住啦，地图上又亮了两格。下一站，我们去运动会。"},
    {"id": "B34", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "在那里，你会遇到两个都要撮圆嘴巴的精灵——一个在吹泡泡，一个在吸果冻。"},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "吹泡泡！我要参加运动会！"},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "那你先把嘴巴练圆。声音探险队，下一站见！"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
