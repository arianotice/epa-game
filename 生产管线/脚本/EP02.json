{
  "ep": "EP02",
  "title": "阳光农场的绵羊与小船",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B07": 0.5, "B17": 0.5, "B18": 0.5, "B27": 0.5, "B28": 0.5, "B29": 0.5, "B34": 0.8},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，欢迎来到元音城堡！上一集我们认识了嘴巴里的乐队，今天开始抓精灵。这座城堡里，住着二十个元音精灵。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "二十个！那我们今天抓哪两个？"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "一对长得特别像、性格却完全相反的姐妹。走，先去今天的场景看看！"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "欢迎来到阳光农场！小Q，你看，远处草地上，那一群白白的是什么？"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一群绵羊！在吃草！这个我认识——sheep！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不错嘛。那你再看，绵羊旁边的小河里，飘着什么？"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "有一条小船！ship！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "好，关键问题来了。sheep 和 ship，这两个词，听起来到底差在哪儿？"},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "嗯……都差不多啊？就差那么一点点？"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "就这一点点，绵羊就变成小船了！你要是分不清，一只绵羊跳上小船，咻——游走了。"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.05, "text": "哈哈哈，绵羊游泳！太好笑了！"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "今天要抓的两个精灵，就藏在这两个词中间。先请出姐姐——微笑小姐！"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "微笑小姐的绝招，就是一个字：笑。你把嘴角用力向两边咧开，露出大大的微笑。"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "像我这样笑吗？"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！笑得越开心，这个音越标准。然后舌面抬高，靠近上颚，声音又亮又长——衣——"},
    {"id": "B11", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sheep."},
    {"id": "X07", "role": "xq", "lang": "en", "speed": 0.9, "text": "sheep!"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完美！记住小窍门：嘴角微笑拉耳边，拖长音。这个音在英语里特别爱出现，你听——"},
    {"id": "B13", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sheep. tree. green."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哇，都是长长的衣！"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "接下来有请妹妹——放松精灵！她的嘴巴张得跟姐姐差不多大，但是——"},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "但是什么？"},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "肌肉全部放松！舌头自然放平，哪儿都别使劲。声音又短又轻——咦。"},
    {"id": "B16", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ship."},
    {"id": "X10", "role": "xq", "lang": "en", "speed": 0.9, "text": "ship!"},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！就是这种松松的、懒懒的感觉。她也有一大家子——"},
    {"id": "B18", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ship. fish. big."},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "ship！fish！big！大象好 big！"},
    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "现在，把两个精灵放在一起对比。姐姐又长又亮，妹妹又短又轻。来，对比读三遍——"},
    {"id": "B20", "role": "bobo", "lang": "en", "speed": 0.75, "text": "sheep. ship. sheep. ship. sheep. ship."},
    {"id": "X12", "role": "xq", "lang": "en", "speed": 0.9, "text": "sheep. ship. sheep. ship. sheep. ship."},
    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！现在进入单词宝藏时间！每个单词我读两遍——先慢速，再常速。仔细听！"},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一组，微笑小姐家的三个小朋友。"},
    {"id": "B23", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sheep. tree. green."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "sheep！tree！green！"},
    {"id": "B24", "role": "bobo", "lang": "en", "speed": 0.85, "text": "sheep. tree. green."},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "绵羊、大树、绿色。三个小朋友，嘴角都要咧开笑。"},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二组，放松精灵家的三个小朋友。"},
    {"id": "B27", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ship. fish. big."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "ship！fish！big！"},
    {"id": "B28", "role": "bobo", "lang": "en", "speed": 0.85, "text": "ship. fish. big."},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小船、鱼、大大的。三个小朋友，嘴巴都要松松的。"},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个单词全部到手！现在进入口诀记忆屋，拍手跟我念——"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "嘴角微笑拉耳边，拖长音，是 sheep；嘴巴微张松又轻，短促咦，是 ship；一只 sheep 游啊游，游成了小船 ship！"},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 0.9, "text": "嘴角微笑拉耳边，拖长音，是 sheep；嘴巴微张松又轻，短促咦，是 ship；一只 sheep 游啊游，游成了小船 ship！"},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满血毕业！接下来是听辨大挑战。我会念两个词，你要大声说出，你听到的是哪一个。"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "准备好了！"},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题！"},
    {"id": "B34", "role": "bobo", "lang": "en", "speed": 0.7, "text": "sheep. ... ship."},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "ship！"},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "是 ship！答对啦！第二题！"},
    {"id": "B36", "role": "bobo", "lang": "en", "speed": 0.7, "text": "seat. ... sit."},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "呃……seat！座位，长长的衣！"},
    {"id": "B37", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——是 sit！坐下！短促的咦！哈哈哈，你被忽悠啦！"},
    {"id": "X19", "role": "xq", "lang": "zh", "speed": 1.05, "text": "啊——！我又上当了！"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别灰心，船长也有翻船的时候。错一道题，才记得牢嘛。第三题，最后一题！"},
    {"id": "B39", "role": "bobo", "lang": "en", "speed": 0.7, "text": "sleep. ... slip."},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "sleep……睡觉？长长的，微笑的，sleep！"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——就是 sleep！答对啦！你想想，今天之后，你再听到 seat 和 sit，耳朵里是不是立刻有两幅画了？"},
    {"id": "X21", "role": "xq", "lang": "zh", "speed": 1.0, "text": "嗯！一个是长长的微笑，一个是短短的放松！"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "没错！你的耳朵，会越来越灵。下一站，我们去早餐桌——"},
    {"id": "X22", "role": "xq", "lang": "zh", "speed": 1.05, "text": "早餐桌！有吃的吗？！"},
    {"id": "B42", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "有鸡蛋，有苹果！不过能不能吃到，要看你能不能抓住那两个精灵啦！"},
    {"id": "X23", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我一定抓住！"},
    {"id": "B43", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "声音探险队，下一站见！"},
    {"id": "X24", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
