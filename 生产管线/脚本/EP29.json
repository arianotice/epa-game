{
  "ep": "EP29",
  "title": "毕业大作战",
  "default_gap": 0.3,
  "gaps": {"B01": 0.5, "B10": 0.7, "B11en": 0.5, "B12en": 0.7, "B13en": 0.5, "B14en": 0.7, "B15en": 0.5, "B16en": 0.7, "B17en": 0.5, "B18en": 0.7, "B19en": 0.5, "B20en": 0.7, "B21en": 0.5, "B22en": 0.7, "B26": 0.6, "B28": 0.8, "B31": 0.6, "B31en": 0.7, "B32en": 0.9, "B34en": 0.5, "B35en": 0.5, "B36en": 0.5, "B37en": 0.9, "B40": 0.6, "B44": 0.6, "B45": 0.5, "B46": 0.2},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，抬头，往下看——还记得我们从哪儿出发的吗？"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哇啊啊——好高！我们会不会掉下去？"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "掉不下去，我拉着你的手。这里是进阶峰，整张地图最高的地方，走过的路一眼全看得见。"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "最远那面小旗子是出发营地。第一天我们在那儿把耳朵和嘴巴叫醒，你说：原来学英语要先练嘴。"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "往里走是元音城堡，二十个元音精灵：微笑小姐、放松精灵、小口大口、医生、泡泡、吹蜡烛。"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "一个都不少。再往前是辅音王国，二十八个，六大家族排队：爆破、摩擦、破擦、鼻音、舌侧、半元音。"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "可你全走完了。再往上就是进阶峰：切音节、找重音、学连读，还学会把爆破音轻轻吞掉。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "原来我们走了这么远……"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "所以今天不抓精灵，今天是验收——毕业大作战。"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "毕业？！我要戴帽子、拿证书！"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "证书在最后，先过关。最容易念错的六对音做成六座擂台：我念两个词，你说第二个是哪个。"},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "就这？我要拿满分！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "先别夸口。这六对最会骗耳朵。深呼吸，第一座擂台，上！"},

    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一擂台：长衣音 对 短衣音。先慢速——"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sheep. ship."},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "sheep. ship."},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第二个是 ship！小船！它特别短！"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题就答对！ship 是短衣音，嘴一松就收；sheep 是长衣音，嘴角往两边拉开，能拖得老长。分辨技巧：拖得长的是绵羊，一冒就收的是小船。"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "sheep！ship！我的嘴角在往耳朵那边跑！"},

    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一座拿下。第二擂台：小口音 对 大口音。听——"},
    {"id": "B13en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "bed. bad."},
    {"id": "B14en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "bed. bad."},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第二个……还是 bed？床？"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "差一点点，第二个是 bad，坏的。小口音只张开一点点，大口音下巴整个掉下来。分辨技巧：还是用手指量嘴——塞半根手指是 bed，塞一整根是 bad。"},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "手指量嘴！bed 塞一半，bad 整个进去！"},

    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二座也扛下来了。第三擂台，难度上来：咬舌音 对 嘶嘶音。"},
    {"id": "B15en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "think. sink."},
    {"id": "B16en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "think. sink."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "呃……第二个是 think？想？"},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "可惜，反了。第二个是 sink，下沉。think 的舌尖探出来搭在牙缝中间；sink 的舌尖躲在牙齿后面嘶嘶叫。分辨技巧：敢探出去的是 think，躲起来的是 sink。探一点点就够。"},

    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第四擂台：上牙碰唇音 对 吻唇音，最容易念成同一个字。"},
    {"id": "B17en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "very. wary."},
    {"id": "B18en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "very. wary."},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 1.0, "text": "两个都是 very！非常！我听不出来！"},
    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——第二个是 wary，小心的。very 开头要咬：上牙搭住下唇，喉咙嗡嗡振动；wary 开头要吻：嘴唇撮圆往前亲一下，牙齿不许碰唇。分辨技巧：牙齿碰唇的是 very，亲空气的是 wary。"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一个咬，一个吻！"},

    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第四座拿下，只剩两座。第五擂台：舌尖鼻音 对 舌根鼻音，捏住鼻子全发不出。"},
    {"id": "B19en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "sin. sing."},
    {"id": "B20en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "sin. sing."},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "这个我听出来了！第二个是 sing，唱歌！"},
    {"id": "B20", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满分！sin 是过错，收尾时舌尖顶住上牙后面的硬台阶；sing 是唱歌，收尾时舌根抬起来顶住喉咙口。分辨技巧：一个在最前面关门，一个在最后面关门。"},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我的舌头在嘴里滑滑梯！前面一下，后面一下！"},

    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "最后一座，全套最难的一对：钩子音 对 卷舌音。"},
    {"id": "B21en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "light. right."},
    {"id": "B22en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "light. right."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我投降！这两个听起来一模一样！"},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别急着投降。light 是灯，开头舌尖当小钩子，钩住上牙后面那道小肉埂，是贴上去的；right 是右边，舌尖也往上往后钩，但是——"},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "但是什么？"},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "但是它哪儿都不许碰：舌尖悬在半空，中间留一条缝，气流从缝里走。这是它跟汉语的日和热最大的区别。分辨技巧：贴上去的是 light，悬空的是 right。"},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "贴上、悬空——真的不一样！"},
    {"id": "B24", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六座擂台全部打完！小Q，转过身看看那张地图。"},

    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哇——！它在发光！从下面一直亮上来！"},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "出发营地亮了，元音城堡二十格全亮了，辅音王国二十八格全亮了，进阶峰四站也亮了。四十八个宝藏格，一个不剩。"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "还剩最后一格是黑的！"},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "那是毕业格，交给你。伸手，按下去。"},
    {"id": "X19", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我按啦——叮！"},
    {"id": "B27", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "全图点亮。四十八个音标精灵，到齐了。"},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "你知道最厉害的是什么吗？不是我把它们教给了你，而是现在你自己的耳朵，能听出绵羊和小船不一样。"},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "一开始听不出来，现在听得出来——这就是进步。它长在你的耳朵和嘴巴里，谁也拿不走。"},

    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不过毕业要过最后一关：毕业朗读挑战。今天这六对的音，我全塞进了一句话里。"},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一句话塞十二个音？那不成绕口令了吗！"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "就是绕口令。先慢速，再常速，仔细听——"},
    {"id": "B31en", "role": "bobo", "lang": "en", "speed": 0.55, "text": "Six sheep on a big ship think the red bed is very bad, and the singer by the right light keeps singing, and still wants to win."},
    {"id": "B32en", "role": "bobo", "lang": "en", "speed": 0.8, "text": "Six sheep on a big ship think the red bed is very bad, and the singer by the right light keeps singing, and still wants to win."},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "意思是：六只绵羊在一艘大船上，觉得那张红床糟透了；右边灯光下的歌手还在唱，还想赢。"},
    {"id": "B34", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别怕，把它切成四小口，一口一口吃。"},
    {"id": "B34en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "Six sheep on a big ship,"},
    {"id": "B35en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "think the red bed is very bad,"},
    {"id": "B36en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "and the singer by the right light"},
    {"id": "B37en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "keeps singing, and still wants to win."},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "现在整句连起来，你自己来。我在这儿等你。"},
    {"id": "X21", "role": "xq", "lang": "zh", "speed": 1.0, "text": "Six sheep on a big ship……哎呀，ship 又变成 sheep 了！"},

    {"id": "B36", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "念错太正常了。念到不打结，这句话就真的是你的了。"},
    {"id": "B37", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "好了小Q，还有耳机前面的你——我们要说再见了。"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "从出发营地到进阶峰顶，你走完了三十站：二十个元音，二十八个辅音，四十八个精灵，一个没落。"},
    {"id": "B39", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "以后碰到没见过的单词，你不会再瞎猜：先看它有几节、重音在哪儿，再一个音一个音拼出来。"},
    {"id": "X22", "role": "xq", "lang": "zh", "speed": 1.0, "text": "我还会捏鼻子检查鼻音，还会用手指量嘴！"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这些小动作，就是你从这套节目里带走的真本事。"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不过，会了不等于永远会。嘴巴这东西，三天不练就生疏。"},
    {"id": "B42", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "所以我只有一个请求：以后听到英语，用耳朵听；不会的，张嘴念一遍。"},
    {"id": "B43", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "耳朵和嘴巴，才是你真正的老师。地图走到尽头，我已经没什么能教你的了。"},
    {"id": "X23", "role": "xq", "lang": "zh", "speed": 1.0, "text": "那我以后还能来找你吗？"},
    {"id": "B44", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "随时。哪一格想复习就点开哪一格，我一直在这儿。"},
    {"id": "B45", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "最后，把探险队的口号，像毕业典礼那样，喊最后一次。预备——起！"},
    {"id": "B46", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "声音探险队，出发！"},
    {"id": "X24", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，出发！"},
    {"id": "B47", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "还有一句，只属于今天的你：声音探险队，毕业快乐！"},
    {"id": "X25", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，毕业快乐！"},
    {"id": "B48", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "耳朵听得清，嘴巴敢出声。四十八个精灵，从今天起，全是你的了。"}
  ]
}
