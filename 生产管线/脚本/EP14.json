{
  "ep": "EP14",
  "title": "风筝与舌根天花板",
  "default_gap": 0.3,
  "gaps": {"B01": 0.6, "B04": 0.5, "B08": 0.5, "B13": 1.0, "B15": 0.5, "B35": 0.5, "X11": 0.5, "B41": 1.0, "B43": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，看地图！爆破音家族这一格又亮了两颗星。今天要抓的这对兄弟，住得比前两对都深——在舌头的最根部。"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "舌头分三段：最前面是舌尖，中间是舌面，最后靠喉咙的那一段叫舌根。今天请舌根出场。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "舌根要干什么？"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "去顶天花板。嘴巴里靠后那块软软的地方叫软腭，你可以把它想成嘴巴的天花板。"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "欢迎来到——放风筝的公园！风正好，草地软绵绵，一只风筝挂在天上，一个小女孩在下面追着线跑。"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "好，先听风筝的名字，开头就是第一声。"},
    {"id": "B06en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "kite."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "风筝 Kite！开头像有人轻轻咳了一下。"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "再听那个小女孩的名字，开头是第二声。"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "girl."},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "女孩 Girl！这一下我的喉咙真的在打嗝！"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "一个像咳嗽，一个像打嗝。出发，进发音实验室！"},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先请第一位：咳嗽音。三步走——第一步，舌根抬起来，顶住软腭，把气流关在喉咙口；第二步，舌根突然松开，气流「咔」地冲出来；第三步，声带休息，不振动。"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "kite."},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "手贴喉咙试了，安安静静，一点都不麻。"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，清音不麻。记住这句口诀：舌根轻轻顶天花板，咳一声——「咔」。"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二位登场：打嗝音。舌根的动作一模一样——还是抬起顶住软腭，还是突然松开。唯一的变化：声带开关打开，喉咙要振动。"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "girl."},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "同样的位置，同样的动作，这一回喉咙咕咕的！"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "口诀只改一个字：舌根轻轻顶天花板，嗝一声——「咕」。咕也是从喉咙深处出来的，只是带着振动。"},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "还是第一集学过的那一招：手贴喉咙测振动。咳嗽音不麻，打嗝音麻。分不清的时候，手一摸就知道。"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "来，对比三连。先咳嗽，再打嗝，慢慢加速。"},
    {"id": "B14en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "cold. gold. cold. gold. cold. gold."},
    {"id": "X10", "role": "xq", "lang": "en", "speed": 0.85, "text": "cold. gold. cold. gold. cold. gold."},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "咳得清楚，嗝得也清楚。两个音用的是同一块舌根，只换了声带开关。"},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "进入单词宝藏时间！六个单词，每个先听慢速，再听中文意思，最后跟着常速读。仔细听！"},
    {"id": "B17", "role": "bobo", "lang": "en", "speed": 0.6, "text": "kite."},
    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "风筝。开头那声咳嗽不带振动，别读成打嗝。准备跟读。"},
    {"id": "B19", "role": "bobo", "lang": "en", "speed": 0.85, "text": "kite."},
    {"id": "B20", "role": "bobo", "lang": "en", "speed": 0.6, "text": "cat."},
    {"id": "B21", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "猫。开头咳嗽一声，结尾也轻轻咳一下，两下都不振动。准备跟读。"},
    {"id": "B22", "role": "bobo", "lang": "en", "speed": 0.85, "text": "cat."},
    {"id": "B23", "role": "bobo", "lang": "en", "speed": 0.6, "text": "key."},
    {"id": "B24", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "钥匙。开门用的钥匙。开头咳一声，短促干脆。准备跟读。"},
    {"id": "B25", "role": "bobo", "lang": "en", "speed": 0.85, "text": "key."},
    {"id": "B26", "role": "bobo", "lang": "en", "speed": 0.6, "text": "girl."},
    {"id": "B27", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "女孩。开头那声嗝要振动，喉咙会麻。准备跟读。"},
    {"id": "B28", "role": "bobo", "lang": "en", "speed": 0.85, "text": "girl."},
    {"id": "B29", "role": "bobo", "lang": "en", "speed": 0.6, "text": "egg."},
    {"id": "B30", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "鸡蛋。嗝声藏在结尾，别把它读成轻轻咳的那一声。准备跟读。"},
    {"id": "B31", "role": "bobo", "lang": "en", "speed": 0.85, "text": "egg."},
    {"id": "B32", "role": "bobo", "lang": "en", "speed": 0.6, "text": "green."},
    {"id": "B33", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "绿色。草地的绿色。开头就振动，喉咙嗡一下。准备跟读。"},
    {"id": "B34", "role": "bobo", "lang": "en", "speed": 0.85, "text": "green."},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个宝藏全部到手！风筝、猫、钥匙归咳嗽音；女孩、鸡蛋、绿色归打嗝音。"},
    {"id": "B36", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "进入口诀记忆屋。一只手贴喉咙，先咳一声，再嗝一声，好好感受一下差别。"},
    {"id": "B37", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "舌根抬起顶软腭，突然松开气流冲；咳嗽一声「咔」不麻，打嗝一声「咕」嗡嗡。同一块舌根肉，声带开关定清浊！"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 0.9, "text": "舌根抬起顶软腭，突然松开气流冲；咳嗽一声「咔」不麻，打嗝一声「咕」嗡嗡。同一块舌根肉，声带开关定清浊！"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "口诀记住了，进入听辨大挑战！每题两个词，判断开头是咳嗽音还是打嗝音。"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一只手贴喉咙，我准备好了！"},
    {"id": "B39", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一题！"},
    {"id": "B39en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "cap. gap."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个不麻，是咳嗽音；第二个喉咙嗡嗡，是打嗝音！"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确！第一颗舌根星到手。第二题，注意草地上多了个东西。"},
    {"id": "B40en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "class. glass."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "两个都是班级！第二个应该是比较大的那个班。"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——第一个是班级，开头不振动；第二个是玻璃杯，开头要振动。你把杯子听成教室啦！"},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啊——！我还以为他们班有五十个人呢！"},
    {"id": "B42", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "错一题才记得牢。第三题，最后一组！"},
    {"id": "B42en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "pick. pig."},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个结尾不振动，是挑选；第二个结尾振动，是小猪！"},
    {"id": "B43", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确！不光开头，结尾也能听出这对兄弟的区别。"},
    {"id": "B44", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "今天之后，你再听到这两个音，手一贴喉咙就知道：麻的是打嗝，不麻的是咳嗽。"},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 1.0, "text": "忘不了！咳嗽「咔」，打嗝「咕」！"},
    {"id": "B45", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "爆破音家族的格子快填满了。下一站，我们走出这个家族，先去花店，再回早餐桌。"},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "花店？要买花送给谁呀？"},
    {"id": "B46", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "送给摩擦音家族。它们不像爆破音那样关门放气，而是让气流从一条小缝里挤出去，一直丝丝地响。"},
    {"id": "B47", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "声音探险队，下一站见！"},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
