{
  "ep": "U18",
  "title": "悄悄话精灵",
  "default_gap": 0.3,
  "gaps": {"B01": 0.5, "B07": 0.5, "B14": 0.6, "X10": 0.5, "B15": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，单元时间到！今天要认识的这位，叫悄悄话精灵。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "悄悄话精灵？它是不是很小声？"},

    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "它专门管你凑到别人耳朵边上说悄悄话的那一下。跟我做前半段：嘴唇微微扁开，舌头抬到前面，又紧又短地——一"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一！好短，好紧！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "别停，接着做后半段：嘴巴整个放松下来，舌头回到嘴巴正中间，轻轻一个——呃"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "呃……嘴巴松下来了。"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "把两半接起来，中间不许停，从前面滑回中间，一口气滑完。仔细听——"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ear"},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一呃！好像真的在说悄悄话！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "这也是一个双元音：一个音不够用，两个音手拉手，中间绝不能断开。前面那个一又紧又短，后面那个呃又松又轻，收得特别快。"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "三件事记牢。舌位：从前面偏高的地方，往后往下滑到嘴巴正中央。气流：一路畅通，嘴巴不挡它。声带：全程都在振动，因为它是元音。"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "嘴巴是先紧后松，像松了一口气！"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，先紧后松。听我读三遍，找找哪一半重——"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ear. ear. ear."},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "前面重！后面松松地收掉！"},

    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一件宝藏：脑袋两边各一个，戴眼镜要挂在它们上面。"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "ear."},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "耳朵。悄悄话精灵本来就住在耳朵里。听常速一遍——"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "ear."},
    {"id": "X07", "role": "xq", "lang": "en", "speed": 0.85, "text": "ear."},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二件宝藏：反义词是远，意思是离得很短一点点。"},
    {"id": "B10en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "near."},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "近。说悄悄话的时候，你得离得特别近。听常速一遍——"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "near."},
    {"id": "X08", "role": "xq", "lang": "en", "speed": 0.85, "text": "near."},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三件宝藏：树林里的动物，头上有角，跑得特别快，圣诞老人用它拉车。"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "deer."},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "鹿。它竖着耳朵，也在听悄悄话呢。听常速一遍——"},
    {"id": "B13en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "deer."},
    {"id": "X09", "role": "xq", "lang": "en", "speed": 0.85, "text": "deer."},

    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "三件宝藏全部到手！进口诀记忆屋，拍手跟我念——"},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "一——呃，是指着耳朵说悄悄话。"},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 0.9, "text": "一——呃，是指着耳朵说悄悄话。"},

    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小挑战来了！听两个词，告诉我哪一个里有悄悄话精灵——"},
    {"id": "B16en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "ear. air."},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个！ear 里前面紧、后面松，air 嘴巴一直是开的！"},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满分！以后再碰到悄悄话精灵，就想想那只竖着耳朵的小鹿：一——呃，凑过去说悄悄话！下个单元见！"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一——呃，指着耳朵说悄悄话！下个单元见！"}
  ]
}
