{
  "ep": "U42",
  "title": "快乐钩子精灵",
  "default_gap": 0.3,
  "gaps": {"B01": 0.5, "B06": 0.6, "B12": 0.5, "B16": 0.6, "B18": 0.5},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！单元时间到！今天这位整天笑嘻嘻，把舌尖卷成小钩子——快乐钩子精灵！"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "小钩子？钩住哪儿呀？"},

    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "舌尖翘成小钩子，钩住上门牙后面的肉坎。气流从舌头两边漏下去，声带要振动。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "钩住啦！气从两边漏！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "他有两副面孔。在词首要清清楚楚，读成「了」，舌尖钩住再弹开。听——"},
    {"id": "B03en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "light."},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "在词尾要故意含糊，读成「欧」，舌尖钩住不放，舌根同时往后抬。听——"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "apple."},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "一个「了」，一个「欧」！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "重点：苹果读「艾泡」，不读「艾普」。词尾那个模糊音不许吞掉。"},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "「艾泡」！不能吞！"},

    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "单词宝藏开门！第一件：一按开关房间就亮起来的东西。"},
    {"id": "B06en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "light."},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "light，就是灯。开头的钩子读「了」，钩住再弹开。听常速——"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "light."},
    {"id": "X05", "role": "xq", "lang": "en", "speed": 0.85, "text": "light."},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二件：黄澄澄的，酸得人直皱眉的水果。"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "lemon."},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "lemon，就是柠檬。开头的钩子要钩得清清楚楚。听常速——"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "lemon."},
    {"id": "X06", "role": "xq", "lang": "en", "speed": 0.85, "text": "lemon."},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三件：草原上吼得最响，脖子围一圈大毛的百兽之王。"},
    {"id": "B10en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "lion."},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "lion，就是狮子。钩子钩住，声音一路滑过去别断开。听常速——"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "lion."},
    {"id": "X07", "role": "xq", "lang": "en", "speed": 0.85, "text": "lion."},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第四件：红红的圆圆的，白雪公主吃的就是它。"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "apple."},
    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "apple，就是苹果。读「艾泡」，不读「艾普」，尾巴不许吞。听常速——"},
    {"id": "B13en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "apple."},
    {"id": "X08", "role": "xq", "lang": "en", "speed": 0.85, "text": "apple."},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第五件：晴天天空的颜色，大海也是这个颜色。"},
    {"id": "B14en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "blue."},
    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "blue，就是蓝色。钩子钩住以后一路滑过去。听常速——"},
    {"id": "B15en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "blue."},
    {"id": "X09", "role": "xq", "lang": "en", "speed": 0.85, "text": "blue."},

    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "五件宝贝到手！进口诀记忆屋，拍手跟我念——"},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "快乐的 lll，舌尖像小钩子钩住上齿龈。"},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 0.9, "text": "快乐的 lll，舌尖像小钩子钩住上齿龈。"},

    {"id": "B18", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小挑战！第一题：钩子精灵在词首读得清楚还是模糊？"},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "清楚！读成「了」！"},
    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二题：苹果到底读「艾泡」还是「艾普」？"},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "读「艾泡」，不是「艾普」！"},
    {"id": "B20", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "两颗星收好！词首清楚了，词尾模糊欧。下一站见！"}
  ]
}
