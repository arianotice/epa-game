{
  "ep": "U15",
  "title": "欢呼精灵",
  "default_gap": 0.3,
  "gaps": {"B01": 0.5, "B04en": 0.4, "B05en": 0.4, "B06": 0.6, "B13": 0.6, "B14": 0.4},
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "声音探险队，单元时间到！今天要认识的新朋友，是个特别爱热闹的家伙——欢呼精灵。"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "欢呼精灵？它是不是会喊耶——？"},

    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "差不多！你一定喊过：小朋友看到喜欢的玩具，脱口就是一句哦——衣！就是它。它也是滑梯家族的，从一个音滑到另一个音。"},
    {"id": "X02", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哦——衣！我真的喊过！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "先找起点：嘴唇收圆，往前突出，像突然想起一件大事，发——哦。再找终点：嘴唇慢慢变扁，舌面往上升，滑到——衣。"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "从圆嘴巴滑到扁嘴巴！"},
    {"id": "B04", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对，从圆到扁，一口气滑完。先听错误版：把哦和衣硬拼在一起，中间断开——"},
    {"id": "B04en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "aw. ee."},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "又是两个字！这个错我记住啦！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "错了就改。欢呼精灵要一口气滑过去，中间没有台阶、没有坎。听我慢慢滑一遍——"},
    {"id": "B05en", "role": "bobo", "lang": "en", "speed": 0.5, "text": "boy."},
    {"id": "X05", "role": "xq", "lang": "en", "speed": 0.85, "text": "boy."},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哇，听起来就像在欢呼！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "记住：起点嘴唇圆，终点嘴唇扁；前面重、后面轻，一口气滑完不许停。单词宝藏时间，走！"},

    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一颗宝石——玩具。"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "toy."},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "toy 是玩具，你房间里堆得满满当当的那些宝贝。"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "toy."},
    {"id": "X07", "role": "xq", "lang": "en", "speed": 0.85, "text": "toy."},
    {"id": "B09", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二颗宝石——男孩。"},
    {"id": "B09en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "boy."},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "boy 是男孩，跟你一起踢球、一起追跑的那个男同学。"},
    {"id": "B10en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "boy."},
    {"id": "X08", "role": "xq", "lang": "en", "speed": 0.85, "text": "boy."},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三颗宝石——吵闹。"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "noise."},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "noise 是吵闹的声音。下课铃一响，走廊里全都是 noise。"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.85, "text": "noise."},
    {"id": "X09", "role": "xq", "lang": "en", "speed": 0.85, "text": "noise."},

    {"id": "B13", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "口诀记忆屋！拍起手，跟我念一遍——"},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "看到玩具哦—衣，欢呼起来。"},
    {"id": "X10", "role": "xq", "lang": "zh", "speed": 0.9, "text": "看到玩具哦—衣，欢呼起来。"},

    {"id": "B15", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "最后是今天的听辨小挑战！我说中文，你大声说出英文：玩具、男孩、吵闹。"},
    {"id": "X11", "role": "xq", "lang": "en", "speed": 0.85, "text": "toy. boy. noise."},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满分！三颗宝石收好，今天你又多了一个精灵朋友，它叫欢呼精灵。声音探险队，下一个单元见！"}
  ]
}
