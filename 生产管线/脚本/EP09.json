    "B45": 0.5
  },
  "segments": [
    {"id": "B01", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "哒哒哒——！声音探险队，出发！"},
    {"id": "B02", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "小Q，元音城堡第八站刚走完。生日派对上那两个滑梯精灵，还记得吗？"},
    {"id": "X01", "role": "xq", "lang": "zh", "speed": 1.0, "text": "记得！蛋糕 cake 是诶—衣，风筝 kite 是啊—衣！"},
    {"id": "B03", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满分。今天第九站，我们钻进玩具箱，还要去看一个正在感冒的小朋友。先考你：那个会发光、会转圈、你最宝贝的东西，英文叫什么？"},
    {"id": "X03", "role": "xq", "lang": "zh", "speed": 1.0, "text": "toy！玩具！"},
    {"id": "B05", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "好，第二个：小明感冒了，一整天用纸巾擦的地方，是哪儿？"},
    {"id": "X04", "role": "xq", "lang": "zh", "speed": 1.0, "text": "鼻子！nose！"},
    {"id": "B06", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "关键问题来了：toy 和 nose 中间那个音，一样吗？"},
    {"id": "X05", "role": "xq", "lang": "zh", "speed": 1.0, "text": "嗯……都是「哦」吧？"},
    {"id": "B07", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "不一样！先请第一位——欢呼精灵。你打开玩具箱，看见最想要的那个，脱口就是一声——"},
    {"id": "B07en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "oy"},
    {"id": "X06", "role": "xq", "lang": "zh", "speed": 1.0, "text": "哦——衣！我每次拆礼物都这么叫！"},
    {"id": "B08", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！它是双元音，从一个圆圆的「哦」滑到一个扁扁的「衣」，中间不能停。它就住在 toy 里。跟我读——"},
    {"id": "B08en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "toy."},
    {"id": "X07", "role": "xq", "lang": "zh", "speed": 1.0, "text": "toy！玩具！记住了：看到玩具，哦—衣，欢呼！"},
    {"id": "B10", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二位精灵嘴里含着一颗糖。嘴巴先圆圆的，再慢慢往前推，像在念字母 O 的名字——"},
    {"id": "B10en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "oh"},
    {"id": "X08", "role": "xq", "lang": "zh", "speed": 1.0, "text": "欧——！我嘴里真的含着糖！"},
    {"id": "B11", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "对！这就是字母 O 自己的名字音，从头圆到尾。它就住在 nose 里。跟我读——"},
    {"id": "B11en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "nose."},
    {"id": "X09", "role": "xq", "lang": "zh", "speed": 1.0, "text": "nose！鼻子！记住了：含颗糖，欧——，圆又滑。"},
    {"id": "B12", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "两个精灵的差别就一句：欢呼精灵从圆滑到扁，嘴巴一路变扁；含糖精灵从头到尾都是圆的。来，对比三连——"},
    {"id": "B12en", "role": "bobo", "lang": "en", "speed": 0.75, "text": "toy. nose. toy. nose. toy. nose."},
    {"id": "X10", "role": "xq", "lang": "en", "speed": 0.95, "text": "toy. nose. toy. nose. toy. nose."},
    {"id": "B14", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "漂亮！进入单词宝藏时间。第一组，欢呼精灵家的小朋友，三个都带那声「哦—衣」。每个单词先慢速，再常速，中间留给你跟读。"},
    {"id": "B16", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第一个：玩具。慢速——"},
    {"id": "B16en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "toy."},
    {"id": "B17", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "toy 就是玩具。你读一遍——"},
    {"id": "B18", "role": "bobo", "lang": "en", "speed": 0.85, "text": "toy."},
    {"id": "X11", "role": "xq", "lang": "zh", "speed": 1.0, "text": "toy！玩具！"},
    {"id": "B19", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二个：男孩。慢速——"},
    {"id": "B19en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "boy."},
    {"id": "B20", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "boy 就是男孩。你也来——"},
    {"id": "B21", "role": "bobo", "lang": "en", "speed": 0.85, "text": "boy."},
    {"id": "X12", "role": "xq", "lang": "zh", "speed": 1.0, "text": "boy！这个小男孩就是我！"},
    {"id": "B22", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第三个：吵闹。慢速——"},
    {"id": "B22en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "noise."},
    {"id": "B23", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "noise 是吵闹的声音。跟着读——"},
    {"id": "B24", "role": "bobo", "lang": "en", "speed": 0.85, "text": "noise."},
    {"id": "X13", "role": "xq", "lang": "zh", "speed": 1.0, "text": "noise！在教室里别 noise！"},
    {"id": "B25", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第二组，含糖精灵家的小朋友，三个都圆圆的。第四个：鼻子。慢速——"},
    {"id": "B25en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "nose."},
    {"id": "B26", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "nose 就是鼻子。你读——"},
    {"id": "B27", "role": "bobo", "lang": "en", "speed": 0.85, "text": "nose."},
    {"id": "X14", "role": "xq", "lang": "zh", "speed": 1.0, "text": "nose！感冒的鼻子！"},
    {"id": "B28", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第五个：家。慢速——"},
    {"id": "B28en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "home."},
    {"id": "B29", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "home 是家，嘴巴要一直圆到最后。来——"},
    {"id": "B30", "role": "bobo", "lang": "en", "speed": 0.85, "text": "home."},
    {"id": "X15", "role": "xq", "lang": "zh", "speed": 1.0, "text": "home！我要回 home！"},
    {"id": "B31", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "第六个，最后一个：小船。慢速——"},
    {"id": "B31en", "role": "bobo", "lang": "en", "speed": 0.6, "text": "boat."},
    {"id": "B32", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "boat 是小船。一起读——"},
    {"id": "B33", "role": "bobo", "lang": "en", "speed": 0.85, "text": "boat."},
    {"id": "X16", "role": "xq", "lang": "zh", "speed": 1.0, "text": "boat！小船划走啦！"},
    {"id": "B34", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "六个单词全部到手！进入口诀记忆屋，拍手跟我念——"},
    {"id": "B35", "role": "bobo", "lang": "zh", "speed": 0.8, "text": "打开箱子，哦—衣，toy 和 boy 吵闹 noise；含颗糖，欧——，nose 通，回 home 的路上划着 boat。欢呼滑两格，含糖圆一颗！"},
    {"id": "X17", "role": "xq", "lang": "zh", "speed": 0.9, "text": "打开箱子，哦—衣，toy 和 boy 吵闹 noise；含颗糖，欧——，nose 通，回 home 的路上划着 boat。欢呼滑两格，含糖圆一颗！"},
    {"id": "B36", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "满血毕业！听辨大挑战，三道题。第一题——"},
    {"id": "B36en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "boy. bow."},
    {"id": "X18", "role": "xq", "lang": "zh", "speed": 1.0, "text": "第一个 boy 是男孩！第二个 bow 是鞠躬，也是弓！"},
    {"id": "B38", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "全对！第一颗星。第二题——"},
    {"id": "B38en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "noise. nose."},
    {"id": "X19", "role": "xq", "lang": "zh", "speed": 1.0, "text": "太简单了！两个都是 nose，鼻子！"},
    {"id": "B39", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "揭晓——第一个是 noise，吵闹！鼻子前面多了一个「衣」，意思就从鼻子变成了吵闹声。"},
    {"id": "X20", "role": "xq", "lang": "zh", "speed": 1.0, "text": "啊——！原来吵闹是长在鼻子上的？"},
    {"id": "B40", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "是噪音钻进了鼻子。错一题才记得牢。第三题，最后一题——"},
    {"id": "B40en", "role": "bobo", "lang": "en", "speed": 0.7, "text": "toy. toe."},
    {"id": "X21", "role": "xq", "lang": "zh", "speed": 1.0, "text": "toy 是玩具，toe 是脚趾！这次我是听嘴巴圆的程度听出来的！"},
    {"id": "B41", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "完全正确！两颗半星，收好。以后再听到这两个音，就问自己一句：这是欢呼，还是含糖？"},
    {"id": "X22", "role": "xq", "lang": "zh", "speed": 1.0, "text": "欢呼是哦—衣，含糖是欧——！忘不了！"},
    {"id": "B43", "role": "bobo", "lang": "zh", "speed": 0.85, "text": "今天的探险就到这里。下一站，我们回家去——那儿有一个看到大房子就「啊—呜」惊叹的精灵，还有一个贴着耳朵说悄悄话的精灵。"},
    {"id": "X23", "role": "xq", "lang": "zh", "speed": 1.0, "text": "回家？悄悄话？这个我最拿手！"},
    {"id": "B45", "role": "bobo", "lang": "zh", "speed": 0.9, "text": "声音探险队，下一站见！"},
    {"id": "X25", "role": "xq", "lang": "zh", "speed": 1.0, "text": "声音探险队，下一站见！"}
  ]
}
